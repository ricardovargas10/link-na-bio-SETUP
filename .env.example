# Copie este arquivo para .env.local (desenvolvimento) e preencha.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.
# Nunca coloque valores reais neste arquivo: ele vai para o GitHub.

# O painel fica em /admin-setup (fixo no código: src/lib/session-token.ts).

# Usuário do painel.
ADMIN_USERNAME=

# Hash bcrypt da senha. Gere com: npm run hash-password
# Na Vercel cole o hash como está. No .env.local use a versão com \$ que o script mostra.
ADMIN_PASSWORD_HASH=

# Segredo que assina o cookie de sessão. Mínimo de 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Banco (Upstash Redis). Criadas sozinhas quando você conecta a Upstash pelo Marketplace da Vercel.
# A integração pode criar um destes dois pares; o código aceita qualquer um.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Opcional: endereço público do site (usado na imagem de compartilhamento).
# Na Vercel não precisa: o domínio de produção é detectado sozinho.
# NEXT_PUBLIC_SITE_URL=https://links.setupenglish.com.br
